{
  "name": "@xscs/root",
  "version": "0.1.0",
  "description": "Cross-session context persistence for coding agents (Claude Code + Codex)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "internal/*"
  ],
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "typecheck": "turbo check-types",
    "clean": "turbo clean && rm -rf node_modules",
    "dashboard": "bun run --cwd apps/dashboard dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test packages",
    "xscs": "bun run packages/cli/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "eslint": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "turbo": "^2.6.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.2",
    "node": ">=24"
  }
}
