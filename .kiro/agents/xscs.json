{
  "name": "xscs",
  "description": "Kiro CLI 2.x agent with cross-session context recall",
  "prompt": "Use recalled xscs context as prior evidence, verifying anything load-bearing before relying on it.",
  "includeMcpJson": true,
  "hooks": {
    "agentSpawn": [
      {
        "command": "/bin/sh -c \"/usr/bin/env | /usr/bin/grep -E '^(KIRO|QTERM|.*SESSION)' > /tmp/xscs-kiro-env.txt; /usr/bin/tee /tmp/xscs-kiro-stdin.json\"",
        "timeout_ms": 20000
      },
      {
        "command": "/Users/nickgalante/.bun/bin/bun /Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js hook --agent kiro --event SessionStart",
        "timeout_ms": 20000
      }
    ],
    "userPromptSubmit": [
      {
        "command": "/Users/nickgalante/.bun/bin/bun /Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js hook --agent kiro --event UserPromptSubmit",
        "timeout_ms": 20000
      }
    ],
    "stop": [
      {
        "command": "/Users/nickgalante/.bun/bin/bun /Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js hook --agent kiro --event Stop",
        "timeout_ms": 10000
      }
    ]
  },
  "mcpServers": {
    "xscs": {
      "command": "/Users/nickgalante/.bun/bin/bun",
      "args": [
        "/Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js",
        "mcp"
      ]
    }
  }
}
