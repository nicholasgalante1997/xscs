{
  "name": "cross-session-summary",
  "version": "0.2.0-alpha.0",
  "description": "xscs — cross-session context store for Claude Code and Codex",
  "type": "module",
  "bin": {
    "xscs": "./dist/xscs.node.js",
    "xscs-bun": "./dist/xscs.js"
  },
  "files": [
    "dist/xscs.js",
    "dist/xscs.node.js",
    "dist/client/app.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "run-s bundle types",
    "bundle": "bun run build.ts",
    "types": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "dependencies": {
    "cac": "^7.0.0"
  },
  "devDependencies": {
    "@xscs/core": "workspace:*",
    "@xscs/dashboard": "workspace:*",
    "@xscs/internal-build-utils": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "latest",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0"
  }
}
