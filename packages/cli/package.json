{
  "name": "@xscs/cli",
  "version": "0.1.0",
  "description": "xscs — cross-session context store for Claude Code and Codex",
  "private": true,
  "type": "module",
  "bin": {
    "xscs": "./dist/xscs.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run-s bundle types",
    "bundle": "bun run build.ts",
    "types": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "dependencies": {
    "@xscs/core": "workspace:*",
    "@xscs/dashboard": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0"
  }
}
