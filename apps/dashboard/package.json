{
  "name": "@xscs/dashboard",
  "version": "0.1.0",
  "description": "Curation dashboard for the cross-session context store",
  "private": true,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "run-s bundle types",
    "bundle": "bun run build.ts",
    "types": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "dev": "bun run --hot src/dev.ts"
  },
  "dependencies": {
    "@xscs/core": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@xscs/internal-build-utils": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0"
  }
}
