{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nickgalante/.bun/bin/bun /Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js hook --agent codex --event SessionStart",
            "timeout": 20,
            "statusMessage": "Recalling stored context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nickgalante/.bun/bin/bun /Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js hook --agent codex --event UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nickgalante/.bun/bin/bun /Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js hook --agent codex --event Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nickgalante/.bun/bin/bun /Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js hook --agent codex --event PreCompact",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/nickgalante/.bun/bin/bun /Users/nickgalante/Claude-Goals/x-session-context-store/packages/cli/dist/xscs.js hook --agent codex --event SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
